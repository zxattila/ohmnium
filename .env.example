# Environment Variables for Ohmnium Contact Form
# Copy this to .env.local for local development

# WordPress Configuration
WP_SITE=https://techcrunch.com

# OpenAI Configuration (for AI chat features)
OPENAI_API_KEY=your_openai_api_key_here

# Contact Form Configuration (Required for netlify/functions/contact.js)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=info@ohmnium.co.uk
BUSINESS_EMAIL=info@ohmnium.co.uk
BUSINESS_NAME=Ohmnium Electricians
DOMAIN=ohmnium.co.uk
SITE_URL=https://ohmnium.co.uk

# Optional: Flowise Configuration 
FLOWISE_API_KEY=your_flowise_api_key
FLOWISE_URL=https://your-flowise-instance.com/api/v1/prediction/flow-id
