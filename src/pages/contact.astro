---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import ContentBlock from "../components/ContentBlock.astro";

// Content data (not displayed due to showContent={false})
const content = {
  mission: {
    title: "",
    description: `
      <p>Get in touch with Ohmnium Electricians for all your electrical needs. Start by calling us on <a href="tel:02035001441" class="text-indigo-500 hover:text-indigo-700 transition-colors duration-200 whitespace-nowrap">020 3500 1441</a> or filling out the form below to make a booking, request an estimate, or make general enquiries. We look forward to hearing from you.</p>
    `,
  },
  styling: {
    containerClass: "",
    titleClass: "",
    contentClass: "",
  },
};
---

<Layout
  title="Contact us | Ohmnium Electricians"
  description="Get in touch with Ohmnium Electricians for rewiring, repairs, inspections, or consumer unit upgrades in Enfield, London & Herts."
  pageType="contact"
  schemaType="ContactPage"
  keywords="Ohmnium Electricians, electrician, electrical services quote, electrician Enfield, London electrician contact, electrical emergency contact, rewiring quote, EICR booking, electrical inspection contact, consumer unit upgrade quote, electrical repairs contact"
>
  <PageHeader
    title="Contact Us"
    description="Get in touch with our electrical experts"
    useNoise={true}
  />

  <section class="max-w-2xl mx-auto px-2 sm:px-4 pb-10">
    <ContentBlock
      title={content.mission.title}
      description={content.mission.description}
      showContent={true}
      containerClass={content.styling.containerClass}
      titleClass={content.styling.titleClass}
      contentClass={content.styling.contentClass}
    />
    <ContactForm />
  </section>
</Layout>
