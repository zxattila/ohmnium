---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import ContentBlock from "../components/ContentBlock.astro";

// Content data (not displayed due to showContent={false})
const content = {
  mission: {
    title: "",
    description: `
      <p>Get in touch with Ohmnium Electrical Services for all your electrical needs. Our qualified team is ready to help with installations, repairs, and maintenance across London.</p>
    `,
  },
  styling: {
    containerClass: "",
    titleClass: "",
    contentClass: "",
  },
};
---

<Layout
  title="Contact Ohmnium Electricians - Professional Electrical Services in London"
  description="Contact Ohmnium Electricians for professional electrical services in London, Herts, Enfield, Essex. Get your free quote today for installations, repairs, inspections and more."
  pageType="contact"
  schemaType="ContactPage"
>
  <PageHeader
    title="Contact Us"
    description="Get in touch with our electrical experts"
    useNoise={true}
  />

  <section class="max-w-2xl mx-auto px-2 sm:px-4 pb-10">
    <ContentBlock
      title={content.mission.title}
      description={content.mission.description}
      showContent={true}
      containerClass={content.styling.containerClass}
      titleClass={content.styling.titleClass}
      contentClass={content.styling.contentClass}
    />
    <ContactForm />
  </section>
</Layout>
