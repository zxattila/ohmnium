---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactHome from "../components/ContactHome.astro";
import ContentBlock from "../components/ContentBlock.astro";

// Content data (not displayed due to showContent={false})
const content = {
  mission: {
    title: "Contact Information",
    description: `
      <p>Get in touch with Ohmnium Electrical Services for all your electrical needs. Our qualified team is ready to help with installations, repairs, and maintenance across London.</p>
    `,
  },
  styling: {
    containerClass: "",
    titleClass: "",
    contentClass: "",
  },
};
---

<Layout
  title="Contact Ohmnium Electricians - Get Your Free Quote"
  description="Contact Ohmnium Electricians for professional electrical services in Staffordshire. Get your free quote today for installations, repairs, inspections and more."
  pageType="contact"
  schemaType="ContactPage"
>
  <PageHeader
    title="Contact Us"
    description="Get in touch with our electrical experts"
    useNoise={true}
  />

  <section class="max-w-screen-lg mx-auto px-4">
    <ContentBlock
      title={content.mission.title}
      description={content.mission.description}
      showContent={false}
      containerClass={content.styling.containerClass}
      titleClass={content.styling.titleClass}
      contentClass={content.styling.contentClass}
    />
    <ContactHome title="Get in Touch" />
  </section>
</Layout>
