---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Pricing from "../components/Pricing.astro";
import ContentBlock from "../components/ContentBlock.astro";

// Content data
const content = {
  mission: {
    title: "Our Services",
    description: `
      <p>At Ohmnium Electrical Services, we provide comprehensive electrical solutions for residential and commercial properties across London. Our qualified electricians deliver safe, reliable, and efficient electrical work to the highest industry standards.</p>

      <p>From routine electrical maintenance and installations to emergency repairs and complete rewiring projects, we handle all aspects of electrical work. Our team is fully certified and insured, ensuring peace of mind for every project we undertake.</p>

      <p>We pride ourselves on transparent pricing, punctual service, and quality workmanship. Whether you need a simple socket installation or a complex commercial electrical system, Ohmnium Electrical Services is your trusted partner for all electrical needs.</p>
    `,
  },
  styling: {
    containerClass: "",
    titleClass: "",
    contentClass: "",
  },
};
---

<Layout>
  <PageHeader
    title="Services"
    description="Electrical solutions for homes and businesses"
    useNoise={true}
  />

  <section class="max-w-4xl mx-auto sm:px-4 pb-10">
    <ContentBlock
      title={content.mission.title}
      description={content.mission.description}
      showContent={false}
      containerClass={content.styling.containerClass}
      titleClass={content.styling.titleClass}
      contentClass={content.styling.contentClass}
    />
    <Pricing />
  </section>
</Layout>
