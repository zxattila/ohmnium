---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ServiceColumns from "../components/ServiceColumns.astro";
import ContentBlock from "../components/ContentBlock.astro";

// Content data
const content = {
  mission: {
    title: "",
    description: `
      <p>We provide comprehensive electrical solutions for residential and commercial properties across London. Our qualified electricians deliver safe, reliable, and efficient electrical work to the highest industry standards.</p>

      <p>From routine electrical maintenance and installations to emergency repairs and complete rewiring projects, we handle all aspects of electrical work. Our team is fully certified and insured, ensuring peace of mind for every project we undertake. We pride ourselves on transparent pricing, punctual service, and quality workmanship. Whether you need a simple socket installation or a complex commercial electrical system, Ohmnium Electrical Services is your trusted partner for all electrical needs.</p>
    `,
  },
  styling: {
    containerClass: "",
    titleClass: "",
    contentClass: "",
  },
};
---

<Layout
  title="Rewiring, Inspections & Consumer Units | Ohmnium Electricians"
  description="Explore all electrical services from Ohmnium Electricians, including full home rewiring, EICR inspections, fault finding, and fusebox upgrades in Enfield & London."
  pageType="default"
  schemaType="WebPage"
  keywords="Ohmnium Electricians, electrical services, rewiring, consumer units, EICR inspections, landlord electrical certificates, PAT testing, emergency lighting, fire alarms, smoke detectors, carbon monoxide alarms, extractor fans, lighting installation, LED upgrades, socket installation, outdoor power, garden lighting, cooker wiring, electric shower installation, smart home automation, ring doorbell, smart security systems, electrical maintenance, electrical repairs, residential electrician, commercial electrician, certified electricians, insured electricians, London, Enfield, Herts, Essex"
>
  <PageHeader
    title="Services"
    description="Electrical solutions for homes and businesses"
    useNoise={true}
  />

  <section class="max-w-3xl mx-auto px-2 sm:px-4 pb-5">
    <ContentBlock
      title={content.mission.title}
      description={content.mission.description}
      showContent={true}
      showTitle={false}
      containerClass={content.styling.containerClass}
      titleClass={content.styling.titleClass}
      contentClass={content.styling.contentClass}
    />
  </section>
  <ServiceColumns showEmojis={false} />
</Layout>
