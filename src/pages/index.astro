---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import RatingWidget from "../components/RatingWidget.astro";
import ContactButton from "../components/ContactButton.astro";
import CardColumns from "../components/CardColumns.astro";
import ImageText from "../components/ImageText.astro";
import Brands from "../components/Brands.astro";
import PostSlider from "../components/PostSliderData.astro";
import Faq, { defaultElectricalFaqItems } from "../components/Faq.astro";
import Banner from "../components/Banner.astro";
import RatingSlider from "../components/RatingSlider.astro";
import ContactHome from "../components/ContactHome.astro";
import { mockReviews } from "../data/reviews";
// import { Image } from "astro:assets";
---

<Layout
  title="Rewiring & EICR Experts in Enfield | Ohmnium Electricians"
  description="Qualified Enfield electricians for rewiring, inspections, fault finding & consumer unit upgrades across London, Herts & Essex."
  pageType="default"
  schemaType="LocalBusiness"
  faqItems={defaultElectricalFaqItems}
  reviews={mockReviews}
  businessName="Ohmnium Electricians"
  businessType="Electrician"
  address={{
    streetAddress: "24 Mount Pleasant",
    addressLocality: "London",
    postalCode: "EN4 9HH",
    addressCountry: "GB",
  }}
  phoneNumber="020 3500 1441"
  email="info@ohmnium.co.uk"
  keywords="electrician, electrical services, Enfield, London, Herts, Essex, rewiring, inspections, fault finding, consumer units, fire alarms, smoke detectors, eicr, electrical safety certificates, emergency electrician, residential electrician, commercial electrician"
>
  <Hero />
  <RatingWidget />
  <ContactButton />
  <CardColumns />
  <ImageText />
  <Brands />
  <PostSlider />
  <Faq />
  <Banner />
  <RatingSlider />
  <ContactHome />
</Layout>
