---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import RatingWidget from "../components/RatingWidget.astro";
import ContactButton from "../components/ContactButton.astro";
import CardColumns from "../components/CardColumns.astro";
import ImageText from "../components/ImageText.astro";
import Brands from "../components/Brands.astro";
import PostSlider from "../components/PostSlider.astro";
import Faq, { defaultElectricalFaqItems } from "../components/Faq.astro";
import Banner from "../components/Banner.astro";
import RatingSlider from "../components/RatingSlider.astro";
import ContactHome from "../components/ContactHome.astro";
import { mockReviews } from "../data/reviews";
// import { Image } from "astro:assets";
---

<Layout
  title="Ohmnium Electricians - Professional Electrical Services in London"
  description="Professional electrical services in London. Qualified electricians for inspections, fault finding, rewiring, consumer units. Free quotes, competitive prices, quality work."
  pageType="default"
  schemaType="LocalBusiness"
  faqItems={defaultElectricalFaqItems}
  reviews={mockReviews}
  businessName="Ohmnium Electricians"
  businessType="Electrician"
  address={{
    streetAddress: "24 Mount Pleasant",
    addressLocality: "London",
    postalCode: "EN4 9HH",
    addressCountry: "GB",
  }}
  phoneNumber="020 3500 1441"
  email="info@ohmnium.co.uk"
  keywords="electrician, electrical services, London, rewiring, inspections, fault finding, consumer units, electrical repairs"
>
  <Hero />
  <RatingWidget />
  <ContactButton />
  <CardColumns />
  <ImageText />
  <Brands />
  <PostSlider />
  <Faq />
  <Banner />
  <RatingSlider />
  <ContactHome />
</Layout>
