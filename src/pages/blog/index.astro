---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostItem from "../../components/PostItem.astro";
import { ClientRouter } from "astro:transitions";
import { WP_API_URL } from "../../config";

// Blog configuration
const blogConfig = {
  comingSoon: {
    title: "Blog Posts Coming Soon",
    description:
      "We're preparing insightful electrical content and expert tips. Check back soon for quality posts about electrical safety, maintenance, and industry updates.",
  },
};

let posts = [];
try {
  const response = await fetch(`${WP_API_URL}/posts?per_page=10&page=1`);
  if (!response.ok) {
    throw new Error(`HTTP error! status: ${response.status}`);
  }
  posts = await response.json();
} catch (error) {
  console.error("Failed to fetch initial posts:", error);
}

const blogUrl = new URL("/blog", Astro.url.origin).pathname;
---

<Layout
  title="The pulse of practical electrical work | Ohmnium Electricians"
  description="Expert articles from Ohmnium Electricians on electrical safety, fault finding, maintenance, and home rewiring in London & Enfield."
  pageType="blog"
  schemaType="Blog"
>
  <!-- Prevent indexing when no blog posts are available -->
  {
    posts.length === 0 && (
      <meta name="robots" content="noindex, nofollow" slot="head" />
    )
  }
  <PageHeader
    title="Blog Posts"
    description="The pulse of practical electrical work"
    useNoise={true}
  />
  <ClientRouter />

  <section class="max-w-4xl mx-auto md:px-4">
    <div id="posts-container" class="space-y-8">
      {posts.map((post) => <PostItem post={post} blogUrl={blogUrl} />)}
    </div>

    {
      posts.length > 0 ? (
        <div class="text-center mt-8 mb-12">
          <button id="load-more" class="button button-primary md:w-auto w-full">
            View More
          </button>
        </div>
      ) : (
        <div class="text-center mt-12 mb-12">
          <div class="bg-surface-card rounded-xl px-4 py-8 shadow-sm">
            <h3 class="text-2xl mb-4">{blogConfig.comingSoon.title}</h3>
            <p class="text-gray-700 max-w-md mx-auto">
              {blogConfig.comingSoon.description}
            </p>
          </div>
        </div>
      )
    }
  </section>
</Layout>

<script define:vars={{ WP_API_URL }}>
  let currentPage = 1;
  const postsContainer = document.getElementById("posts-container");
  const loadMoreButton = document.getElementById("load-more");
  const blogUrl = new URL("/blog", window.location.origin).pathname;

  async function loadMorePosts() {
    try {
      currentPage++;

      const response = await fetch(
        `${WP_API_URL}/posts?per_page=10&page=${currentPage}`,
      );
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const newPosts = await response.json();

      if (newPosts.length === 0) {
        loadMoreButton.style.display = "none";
        return;
      }

      newPosts.forEach((post) => {
        const article = document.createElement("article");
        article.className =
          "post-item bg-surface-card flex flex-col h-full px-3 py-5 sm:p-5 rounded-xl shadow-sm hover:shadow-md transition-shadow opacity-0";

        const date = new Date(post.date).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        });

        article.innerHTML = `
          <div class="text-sm mb-2">${date}</div>
          <a href="${blogUrl}/${post.slug}" class="block group transition-colors">
            <h2 class="text-xl mb-4 group-hover:text-indigo-700 transition-colors">${post.title.rendered}</h2>
          </a>
          <div class="prose line-clamp-3 mb-4">${post.excerpt.rendered}</div>
          <a href="${blogUrl}/${post.slug}" class="hover:underline inline-flex items-center mt-auto">
            Read More
            <span class="ml-1">→</span>
          </a>
        `;

        postsContainer.appendChild(article);

        setTimeout(() => {
          article.style.transition = "opacity 0.5s ease-in-out";
          article.style.opacity = "1";
        }, 50);
      });
    } catch (error) {
      console.error("Error loading more posts:", error);
      const errorDiv = document.createElement("div");
      errorDiv.className = "text-center p-4 text-red-600";
      errorDiv.textContent =
        "Failed to load more posts. Please try again later.";
      postsContainer.appendChild(errorDiv);
    }
  }

  loadMoreButton?.addEventListener("click", loadMorePosts);
</script>
