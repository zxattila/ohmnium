---
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';

export async function getStaticPaths() {
  const WP_SITE = 'https://techcrunch.com';
  const WP_API_URL = `${WP_SITE}/wp-json/wp/v2`;
  
  try {
    const response = await fetch(`${WP_API_URL}/posts?per_page=100`);
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    const posts = await response.json();
    
    return posts.map((post, index) => {
      const postDate = new Date(post.date);
      const year = postDate.getFullYear();
      const month = String(postDate.getMonth() + 1).padStart(2, '0');
      const day = String(postDate.getDate()).padStart(2, '0');
      
      const prevPost = posts[index - 1];
      const nextPost = posts[index + 1];
      
      return {
        params: {
          slug: `${year}/${month}/${day}/${post.slug}`
        },
        props: { 
          post,
          prevPost,
          nextPost,
          page: {
            url: {
              prev: prevPost ? `/${new Date(prevPost.date).getFullYear()}/${String(new Date(prevPost.date).getMonth() + 1).padStart(2, '0')}/${String(new Date(prevPost.date).getDate()).padStart(2, '0')}/${prevPost.slug}` : null,
              next: nextPost ? `/${new Date(nextPost.date).getFullYear()}/${String(new Date(nextPost.date).getMonth() + 1).padStart(2, '0')}/${String(new Date(nextPost.date).getDate()).padStart(2, '0')}/${nextPost.slug}` : null
            },
            currentPage: index + 1,
            lastPage: posts.length,
            total: posts.length
          }
        }
      };
    });
  } catch (error) {
    console.error('Error fetching posts:', error);
    return [];
  }
}

const { post, page, prevPost, nextPost } = Astro.props;

const formattedDate = new Date(post.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout>
  <article class="max-w-3xl mx-auto px-4 py-8">
    <div class="text-gray-500 mb-4">{formattedDate}</div>
    <h1 class="text-4xl font-bold mb-6">{post.title.rendered}</h1>
    <div class="prose prose-lg max-w-none" set:html={post.content.rendered}></div>
    
    <div class="mt-12">
      <Pagination page={page} prevPost={prevPost} nextPost={nextPost} />
    </div>
    
    <div class="text-center mt-8">
      <a 
        href="/blog" 
        class="inline-block px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
      >
        ← Back to All Posts
      </a>
    </div>
  </article>
</Layout>