---
import Layout from "../../layouts/Layout.astro";
import Pagination from "../../components/Pagination.astro";
import { WP_API_URL } from "../../config";

// Define simplified WordPress post interface - only essential data
interface WordPressPost {
  id: number;
  slug: string;
  title: {
    rendered: string;
  };
  content: {
    rendered: string;
  };
  excerpt: {
    rendered: string;
  };
  date: string;
  modified?: string;
  // Optional custom fields for schema if you add them to WP
  schema_title?: string;
  schema_description?: string;
}

export async function getStaticPaths() {
  // const WP_SITE = "https://techcrunch.com";
  // const WP_API_URL = `${WP_SITE}/wp-json/wp/v2`;

  let posts: WordPressPost[] = [];
  try {
    const response = await fetch(`${WP_API_URL}/posts?per_page=100`);
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    posts = await response.json();
  } catch (error) {
    console.error("Failed to fetch posts:", error);
    return [];
  }

  return posts.map((post, index) => {
    const prevPost = index > 0 ? posts[index - 1] : null;
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;

    return {
      params: { slug: post.slug },
      props: {
        post,
        prevPost,
        nextPost,
        page: {
          url: {
            prev: prevPost ? `/blog/${prevPost.slug}` : null,
            next: nextPost ? `/blog/${nextPost.slug}` : null,
          },
        },
      },
    };
  });
}

const { post, page, prevPost, nextPost } = Astro.props as {
  post: WordPressPost;
  page: any;
  prevPost: WordPressPost | null;
  nextPost: WordPressPost | null;
};

const formattedDate = new Date(post.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Use custom schema fields if available, otherwise fall back to standard fields
const schemaTitle =
  post.schema_title || post.title.rendered.replace(/<[^>]*>/g, "").trim();
const cleanExcerpt = post.excerpt.rendered.replace(/<[^>]*>/g, "").trim();
const schemaDescription =
  post.schema_description ||
  cleanExcerpt ||
  `Professional electrical insights from Ohmnium Electricians.`;
---

<Layout
  title={schemaTitle}
  description={schemaDescription}
  pageType="blog"
  type="article"
  schemaType="BlogPosting"
  datePublished={post.date}
  dateModified={post.modified}
>
  <article class="single max-w-3xl mx-auto md:px-4 py-8">
    <div class="text-gray-500 mb-4">{formattedDate}</div>
    <h1 class="text-4xl mb-6" set:html={post.title.rendered} />
    <div
      class="prose prose-lg max-w-none md:text-lg first-child-spacing"
      set:html={post.content.rendered}
    />

    <div class="mt-12">
      <Pagination page={page} prevPost={prevPost} nextPost={nextPost} />
    </div>

    <div class="text-center mt-10">
      <a href="/blog" class="button button-primary"> ← Back to All Posts </a>
    </div>
  </article>
</Layout>
