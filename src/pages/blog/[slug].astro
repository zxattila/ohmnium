---
import Layout from "../../layouts/Layout.astro";
import Pagination from "../../components/Pagination.astro";
import { WP_API_URL } from "../../config";

export async function getStaticPaths() {
  // const WP_SITE = "https://techcrunch.com";
  // const WP_API_URL = `${WP_SITE}/wp-json/wp/v2`;

  let posts = [];
  try {
    const response = await fetch(`${WP_API_URL}/posts?per_page=100`);
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    posts = await response.json();
  } catch (error) {
    console.error("Failed to fetch posts:", error);
    return [];
  }

  return posts.map((post, index) => {
    const prevPost = index > 0 ? posts[index - 1] : null;
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;

    return {
      params: { slug: post.slug },
      props: {
        post,
        prevPost,
        nextPost,
        page: {
          url: {
            prev: prevPost ? `/blog/${prevPost.slug}` : null,
            next: nextPost ? `/blog/${nextPost.slug}` : null,
          },
        },
      },
    };
  });
}

const { post, page, prevPost, nextPost } = Astro.props;

const formattedDate = new Date(post.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout>
  <article class="single max-w-3xl mx-auto md:px-4 py-8">
    <div class="text-gray-500 mb-4">{formattedDate}</div>
    <h1 class="text-4xl mb-6" set:html={post.title.rendered} />
    <div
      class="prose prose-lg max-w-none md:text-lg first-child-spacing"
      set:html={post.content.rendered}
    />

    <div class="mt-12">
      <Pagination page={page} prevPost={prevPost} nextPost={nextPost} />
    </div>

    <div class="text-center mt-10">
      <a href="/blog" class="button button-primary"> ← Back to All Posts </a>
    </div>
  </article>
</Layout>
