---
import "../styles/theme.scss";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HeadMetas from "../components/HeadMetas.astro";
import HeadSeo from "../components/HeadSeo.astro";
import "@fortawesome/fontawesome-free/css/all.min.css";
import type { AccordionItem } from "../components/Faq.astro";
import type { GooglePlacesReview } from "../data/reviews";

// Import critical assets for preloading
import noiseImage from "../assets/noise.png";
import noisierImage from "../assets/noisier.png";

// Get WordPress site URL for DNS prefetch
const WP_SITE = import.meta.env.WP_SITE || "https://techcrunch.com";

export interface Props {
  title?: string;
  description?: string;
  pageType?: "default" | "blog" | "contact" | "about";
  type?: "website" | "article" | "product" | "product.group";
  schemaType?:
    | "WebPage"
    | "ContactPage"
    | "AboutPage"
    | "Organization"
    | "Blog"
    | "BlogPosting"
    | "FAQPage"
    | "LocalBusiness";
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  twitterHandle?: string;
  datePublished?: string;
  dateModified?: string;
  author?: string;
  faqItems?: AccordionItem[];
  reviews?: GooglePlacesReview[];
  businessName?: string;
  businessType?: string;
  address?: {
    streetAddress?: string;
    addressLocality?: string;
    addressRegion?: string;
    postalCode?: string;
    addressCountry?: string;
  };
  phoneNumber?: string;
  email?: string;
  keywords?: string;
  robots?: string;
  language?: string;
  businessPhone?: string;
  businessAddress?: string;
}

const {
  title = "Ohmnium Electricians",
  description = "Professional electrical services. From inspections and fault finding to full rewiring and consumer unit upgrades.",
  pageType = "default",
  type = "website",
  schemaType = "WebPage",
  image,
  imageWidth,
  imageHeight,
  twitterHandle,
  datePublished,
  dateModified,
  author,
  faqItems,
  reviews,
  businessName,
  businessType,
  address,
  phoneNumber,
  email,
  keywords,
  robots,
  language,
  businessPhone,
  businessAddress,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Performance optimization meta tags -->
    <meta name="theme-color" content="#1e40af" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- Preload critical above-the-fold image with mobile-first priority -->
    <link
      rel="preload"
      href={noiseImage.src}
      as="image"
      type="image/png"
      media="(max-width: 767px)"
    />
    <link
      rel="preload"
      href={noisierImage.src}
      as="image"
      type="image/png"
      media="(min-width: 768px)"
    />

    <!-- DNS prefetch for WordPress API (client-side API calls) -->
    <link rel="dns-prefetch" href={new URL(WP_SITE).origin} />

    <!-- SEO Head Metas Component -->
    <HeadMetas
      title={title}
      description={description}
      type={type}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      twitterHandle={twitterHandle}
      keywords={keywords}
      author={author}
      robots={robots}
      language={language}
      businessName={businessName}
      businessPhone={businessPhone}
      businessAddress={businessAddress}
    />

    <!-- SEO Schema Component -->
    <HeadSeo
      title={title}
      description={description}
      schemaType={schemaType}
      datePublished={datePublished}
      dateModified={dateModified}
      author={author}
      faqItems={faqItems}
      reviews={reviews}
      businessName={businessName}
      businessType={businessType}
      address={address}
      phoneNumber={phoneNumber}
      email={email}
    />

    <!-- Load main script (preloaded above) -->
    <script src="../scripts/main.js"></script>
  </head>
  <body class={`page-${pageType}`}>
    <!-- Skip to content link for screen readers -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:text-black focus:px-4 focus:py-2 focus:rounded focus:shadow-lg"
    >
      Skip to main content
    </a>

    <!-- Mobile menu overlay - placed at body level -->
    <div
      x-data
      x-show="$store.navigation.isMenuOpen"
      @click="$store.navigation.toggle()"
      class="fixed inset-0 bg-base-100 bg-opacity-70 z-30 cursor-pointer"
      style="display: none;"
    >
    </div>

    <Navigation />
    <main id="main" class="container py-5">
      <slot />
    </main>
    <Footer />
  </body>
</html>
