---
import "../styles/theme.scss";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import "@fortawesome/fontawesome-free/css/all.min.css";

export interface Props {
  title?: string;
  description?: string;
  pageType?: "default" | "blog" | "contact" | "about";
}

const {
  title = "Ohmnium - Electrical Services",
  description,
  pageType = "default",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script src="../scripts/main.js"></script>
  </head>
  <body class={`page-${pageType}`}>
    <!-- Mobile menu overlay - placed at body level -->
    <div
      x-data
      x-show="$store.navigation.isMenuOpen"
      @click="$store.navigation.toggle()"
      class="fixed inset-0 bg-base-100 bg-opacity-70 z-30 cursor-pointer"
      style="display: none;"
    >
    </div>

    <Navigation />
    <main class="container mx-auto py-5">
      <slot />
    </main>
    <Footer />
  </body>
</html>
