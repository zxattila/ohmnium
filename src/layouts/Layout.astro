---
import "../styles/theme.scss";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HeadMetas from "../components/HeadMetas.astro";
import HeadSeo from "../components/HeadSeo.astro";
import "@fortawesome/fontawesome-free/css/all.min.css";
import type { AccordionItem } from "../components/Faq.astro";

export interface Props {
  title?: string;
  description?: string;
  pageType?: "default" | "blog" | "contact" | "about";
  type?: "website" | "article" | "product" | "product.group";
  schemaType?:
    | "WebPage"
    | "ContactPage"
    | "AboutPage"
    | "Organization"
    | "Blog"
    | "BlogPosting"
    | "FAQPage";
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  twitterHandle?: string;
  datePublished?: string;
  dateModified?: string;
  author?: string;
  faqItems?: AccordionItem[];
}

const {
  title = "Ohmnium - Electrical Services",
  description = "Professional electrical services in Staffordshire. From inspections and fault finding to full rewiring and consumer unit upgrades.",
  pageType = "default",
  type = "website",
  schemaType = "WebPage",
  image,
  imageWidth,
  imageHeight,
  twitterHandle,
  datePublished,
  dateModified,
  author,
  faqItems,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Head Metas Component -->
    <HeadMetas
      title={title}
      description={description}
      type={type}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      twitterHandle={twitterHandle}
    />

    <!-- SEO Schema Component -->
    <HeadSeo
      title={title}
      description={description}
      schemaType={schemaType}
      datePublished={datePublished}
      dateModified={dateModified}
      author={author}
      faqItems={faqItems}
    />

    <script src="../scripts/main.js"></script>
  </head>
  <body class={`page-${pageType}`}>
    <!-- Mobile menu overlay - placed at body level -->
    <div
      x-data
      x-show="$store.navigation.isMenuOpen"
      @click="$store.navigation.toggle()"
      class="fixed inset-0 bg-base-100 bg-opacity-70 z-30 cursor-pointer"
      style="display: none;"
    >
    </div>

    <Navigation />
    <main class="container py-5">
      <slot />
    </main>
    <Footer />
  </body>
</html>
