---
interface Props {
  imgSrc: string;
  title: string;
  description: string;
  showImage?: boolean;
  titleClass?: string;
  textClass?: string;
  cardClass?: string;
  showSvg?: boolean;
  svgContent?: string;
  svgClasses?: string;
}

const {
  imgSrc,
  title,
  description,
  showImage = false,
  titleClass = "uppercase mb-0",
  textClass = "leading-snug",
  cardClass = "",
  showSvg = false,
  svgContent = "",
  svgClasses = "",
} = Astro.props;
---

<div
  class={`card w-full shadow-sm hover:shadow-md transition-shadow relative ${cardClass}`}
>
  {showSvg && svgContent && <div class={svgClasses} set:html={svgContent} />}
  {
    showImage && (
      <figure class="aspect-[3/1]">
        <img src={imgSrc} alt={title} class="w-full h-full object-cover" />
      </figure>
    )
  }
  <div class="card-body">
    <h3 class={titleClass}>{title}</h3>
    <p class={textClass}>{description}</p>
  </div>
</div>
