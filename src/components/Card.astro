---
interface Props {
  imgSrc: string;
  title: string;
  description: string;
}

const { imgSrc, title, description } = Astro.props;
---

<div
  class="card bg-surface-card w-full shadow-sm hover:shadow-md transition-shadow"
>
  <figure class="aspect-[2/1]">
    <img src={imgSrc} alt={title} class="w-full h-full object-cover" />
  </figure>
  <div class="card-body px-5">
    <h3 class="text-base uppercase mb-0">{title}</h3>
    <p class="text-base leading-snug">{description}</p>
  </div>
</div>
