---
interface Props {
  imgSrc: string;
  title: string;
  description: string;
}

const { imgSrc, title, description } = Astro.props;
---

<div class="card bg-surface-card w-full shadow-sm flex-1">
  <figure class="aspect-[2/1]">
    <img src={imgSrc} alt={title} class="w-full h-full object-cover" />
  </figure>
  <div class="card-body">
    <h2 class="card-title">{title}</h2>
    <p>{description}</p>
  </div>
</div>
