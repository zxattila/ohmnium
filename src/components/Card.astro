---
import type { ImageMetadata } from "astro";

interface Props {
  imgSrc: string | ImageMetadata;
  title: string;
  description: string;
  showImage?: boolean;
  titleClass?: string;
  textClass?: string;
  cardClass?: string;
  showSvg?: boolean;
  svgContent?: string;
  svgClasses?: string;
  // New props for dynamic image sizing
  cardWidths?: number[];
  cardSizes?: string;
}

const {
  imgSrc,
  title,
  description,
  showImage = false,
  titleClass = "uppercase mb-0",
  textClass = "leading-snug",
  cardClass = "",
  showSvg = false,
  svgContent = "",
  svgClasses = "",
  // Default card-optimized image settings - mobile-first approach
  cardWidths = [480, 640, 800, 1024], // Mobile: 480px, sm: 640px, lg: 800px, xl: 1024px
  cardSizes = "(max-width: 639px) 480px, (max-width: 1023px) 320px, 280px", // Mobile-first: full-width mobile, 2-col tablet, 4-col desktop
} = Astro.props;

// Determine if we should use optimized images
const isImageMetadata = typeof imgSrc === "object" && imgSrc !== null;

// Dynamic import of Image component only when needed
const Image = isImageMetadata ? (await import("./Image.astro")).default : null;
---

<div
  class={`card w-full shadow-sm hover:shadow-md transition-shadow relative ${cardClass}`}
>
  {showSvg && svgContent && <div class={svgClasses} set:html={svgContent} />}
  {
    showImage && (
      <figure class="aspect-[3/1]">
        {isImageMetadata && Image ? (
          <Image
            src={imgSrc as ImageMetadata}
            alt={title}
            widths={cardWidths}
            sizes={cardSizes}
            formats={["webp", "avif"]}
            quality={85}
            class="w-full h-full object-cover"
            lazy={true}
          />
        ) : (
          <img
            src={imgSrc as string}
            alt={title}
            class="w-full h-full object-cover"
          />
        )}
      </figure>
    )
  }
  <div class="card-body">
    <h2 class={titleClass}>{title}</h2>
    <p class={textClass}>{description}</p>
  </div>
</div>
