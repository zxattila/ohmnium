---
// Footer nav items array - simple dynamic list
const footerNavItems = [
  { href: "/", text: "Home" },
  { href: "/about", text: "About" },
  { href: "/services", text: "Services" },
  { href: "/blog", text: "Blog" },
];
---

<div class="mt-6">
  <p class="text-gray-600 text-sm">Try searching for what you need:</p>
  <div class="mt-3">
    {
      footerNavItems.map((item, index) => (
        <>
          <a href={item.href} class="text-brand-secondary hover:underline mx-2">
            {item.text}
          </a>
          {index < footerNavItems.length - 1 && (
            <span class="text-gray-400">•</span>
          )}
        </>
      ))
    }
  </div>
</div>
