---
interface Props {
  title: string;
  description: string;
  showContent?: boolean;
  containerClass?: string;
  titleClass?: string;
  contentClass?: string;
}

const {
  title,
  description,
  showContent = true,
  containerClass = "",
  titleClass = "",
  contentClass = "",
} = Astro.props;
---

{
  showContent && (
    <div class={`prose prose-lg ${containerClass}`}>
      <h2 class={titleClass}>{title}</h2>
      <div
        set:html={description}
        class={`prose prose-lg first-child-spacing ${contentClass}`}
      />
    </div>
  )
}
