---
import ContactForm from "./ContactForm.astro";
import ContentBlock from "./ContentBlock.astro";

interface Props {
  title?: string;
}

const content = {
  mission: {
    title: "Contact us",
    description: `
      <p>Need an electrician in London, Enfield, Herts, Essex? Call us on <a href="tel:02035001441" class="text-indigo-500 hover:text-indigo-700 transition-colors duration-200 whitespace-nowrap">020 3500 1441</a> or fill out the form below for bookings, estimates, or enquiries. Fast, reliable service guaranteed.</p>
    `,
  },
  styling: {
    containerClass: "mb-5",
    titleClass: "text-4xl md:text-5xl",
    contentClass: "",
  },
};
---

<section class="md:max-w-2xl w-full mx-auto py-10">
  <!-- <h2 class="text-4xl md:text-5xl" set:html={title} /> -->
  <ContentBlock
    title={content.mission.title}
    description={content.mission.description}
    showContent={true}
    containerClass={content.styling.containerClass}
    titleClass={content.styling.titleClass}
    contentClass={content.styling.contentClass}
  />
  <div class="bg-white rounded-lg shadow-lg px-2 md:px-4 py-5">
    <ContactForm />
  </div>
</section>
