---
import ContactForm from "./ContactForm.astro";

interface Props {
  title?: string;
}

const { title = "Contact us" } = Astro.props;
---

<div class="md:max-w-2xl mx-auto md:px-4 py-12 md:py-20">
  <h2 class="text-4xl md:text-5xl font-bold text-black mb-8" set:html={title} />
  <ContactForm />
</div>
