---
import flower from "../assets/flower-orange.svg";

interface Props {
  title?: string;
  description?: string;
  svgSrc?: string;
}

const {
  title = "London<br>Herts<br>Essex<br>Enfield",
  description = "Your trusted partner for modern electrical solutions.",
  svgSrc = flower.src,
} = Astro.props;
---

<section class="relative bg-brand-secondary rounded-xl">
  <!-- Background Overlay -->
  <div
    class="absolute inset-0 bg-no-repeat bg-cover bg-center opacity-30"
    style="background-image: url('/src/assets/noisier.png');"
  >
  </div>

  <!-- Content -->
  <div
    class="relative z-10 flex flex-col items-center justify-center md:flex-row md:items-end md:justify-between mx-auto py-5 px-2 sm:p-5 md:gap-5"
  >
    <h1
      class="text-center mb-4 md:mb-0 md:text-left text-5xl md:text-6xl font-bold text-white md:max-w-[40%] lg:max-w-[50%]"
      set:html={title}
    />
    <p
      class="text-center md:text-left text-base md:text-lg text-white md:max-w-[60%] lg:max-w-[50%]"
    >
      {description}
    </p>
  </div>

  <!-- Absolute Positioned SVG -->
  <!-- <img
    src={svgSrc}
    alt="Decorative flower"
    class="absolute -right-3 md:right-5 top-[75%] md:top-5 w-12 h-12 md:w-16 md:h-16 transform -translate-y-1/2 md:translate-y-0 transition-all duration-300 ease-in-out"
    style="margin-bottom: -10px;"
  /> -->
</section>
