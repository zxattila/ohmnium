---
import defaultImage from "../assets/electrician-abstract.jpg";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata | string;
  alt?: string;
  class?: string;
  height?: string;
  text?: string;
  showOverlay?: boolean;
}

const {
  src = defaultImage,
  alt = "Electrician working on a circuit board",
  class: classList = "",
  height = "auto",
  text = "We believe great service starts with clear communication. No missed appointments, no vague pricing, no chasing for updates. Just reliable, straight forward support that puts your needs first so even the biggest jobs feel simple.",
  showOverlay = true,
} = Astro.props;

// Determine if we should use optimized images
const isImageMetadata = typeof src === "object" && src !== null;

// Dynamic import of Image component only when needed
const Image = isImageMetadata ? (await import("./Image.astro")).default : null;
---

<section class="full-width-container">
  {
    isImageMetadata && Image ? (
      <Image
        src={src as ImageMetadata}
        alt={alt}
        widths={[640, 768, 1024, 1280, 1536]}
        sizes="100vw"
        formats={["webp", "avif"]}
        quality={85}
        class={`w-full object-cover h-56 md:h-64 lg:h-80 ${classList}`}
        lazy={false}
      />
    ) : (
      <img
        src={src as string}
        alt={alt}
        class={`w-full object-cover h-56 md:h-64 lg:h-80 ${classList}`}
      />
    )
  }

  {
    text && showOverlay && (
      <>
        <div class="absolute inset-0 bg-black bg-opacity-40" />
        <div class="absolute inset-0 glass backdrop-blur-lg flex items-center justify-center px-2 sm:px-5 md:px-10">
          <div class="text-container text-center">
            <p class="text-white prose text-sm sm:text-base md:text-xl leading-relaxed">
              {text}
            </p>
          </div>
        </div>
      </>
    )
  }
</section>

<style>
  .full-width-container {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  .text-container {
    width: 100%; /* mobile default */
    max-width: 96ch; /* character-based max width */
  }

  @media (min-width: 768px) {
    .text-container {
      width: 80%; /* md: 80% */
    }
  }

  @media (min-width: 1024px) {
    .text-container {
      width: 70%; /* lg: 70% */
    }
  }
</style>
