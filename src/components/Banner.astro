---
interface Props {
  title?: string;
}

const { title = "Your trusted partner for modern electrical solutions." } =
  Astro.props;
---

<section class="py-10">
  <div class="bg-surface-banner relative rounded-xl w-full hidden md:block">
    <!-- Background Overlay -->
    <div
      class="absolute inset-0 bg-no-repeat bg-cover bg-center opacity-50"
      style="background-image: url('/src/assets/noise.png');"
    >
    </div>
    <div class="px-5 md:py-14 lg:py-20 h-full flex items-center justify-center">
      <h4
        class="font-heading leading-normal md:text-2xl lg:text-3xl text-white mb-0"
      >
        {title}
      </h4>
    </div>
  </div>
</section>
