---
interface SocialLink {
  url: string;
  icon: string;
  label: string;
  size: string;
}

const socialLinks: SocialLink[] = [
  {
    url: "https://www.linkedin.com/in/kyleguler/",
    icon: "fa-brands fa-linkedin",
    label: "LinkedIn",
    size: "fa-4x",
  },
  {
    url: "https://facebook.com/ohmnium",
    icon: "fa-brands fa-facebook",
    label: "Facebook",
    size: "fa-4x",
  },
];

// Contact information
const contactInfo = {
  brand: "Ohmnium",
  heading: "Ohmnium Electricians",
  address: "24 Mount Pleasant<br>London, EN4 9HH",
  phone: "020 3500 1441",
  phoneHref: "tel:+442035001441",
  email: "info@ohmnium.co.uk",
  emailHref: "mailto:info@ohmnium.co.uk",
};

const currentYear = new Date().getFullYear();
---

<footer class="py-5 container mx-auto">
  <!-- Contact Information -->
  <div class="mb-8">
    <h4 class="text-base text-black mb-4">{contactInfo.heading}</h4>
    <p class="text-gray-700 mb-2" set:html={contactInfo.address} />
    <div class="space-y-1">
      <div>
        <a
          href={contactInfo.phoneHref}
          class="text-gray-700 hover:text-gray-900 transition duration-300 no-underline"
        >
          {contactInfo.phone}
        </a>
      </div>
      <div>
        <a
          href={contactInfo.emailHref}
          class="text-gray-700 hover:text-gray-900 transition duration-300 no-underline"
        >
          {contactInfo.email}
        </a>
      </div>
    </div>
  </div>

  <!-- Social Links -->
  <div class="flex mb-5 gap-6 items-center">
    {
      socialLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-state-info/95 hover:text-state-info transition duration-300"
          aria-label={`Visit our ${link.label} page`}
        >
          <i class={`${link.icon} ${link.size}`} aria-hidden="true" />
        </a>
      ))
    }
  </div>
  <span class="text-state-info font-heading uppercase text-sm text-bold"
    >© {currentYear} {contactInfo.brand}</span
  >
</footer>
