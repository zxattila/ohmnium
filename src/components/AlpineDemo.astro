<div
  x-data="counter"
  class="max-w-md mx-auto bg-white p-6 rounded-lg shadow-md mt-8"
>
  <h2 class="text-2xl font-bold mb-4">Alpine.js Counter Demo</h2>
  
  <div class="flex items-center justify-center space-x-4 mb-4">
    <button
      @click="decrement"
      class="btn btn-secondary"
    >
      -
    </button>
    
    <span
      x-text="count"
      class="text-2xl font-bold min-w-[3rem] text-center"
    ></span>
    
    <button
      @click="increment"
      class="btn btn-primary"
    >
      +
    </button>
  </div>
  
  <div class="text-center text-gray-600">
    <p x-show="count === 0">Start counting!</p>
    <p x-show="count > 0">Keep going up!</p>
    <p x-show="count < 0">Going negative!</p>
  </div>
</div>