---
import PostItem from './PostItem.astro';

const postCount = 5;
const WP_SITE = 'https://www.lucieslist.com/';
const WP_API_URL = `${WP_SITE}/wp-json/wp/v2`;

async function fetchWithRetry(url, maxRetries = 3) {
  const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));
  
  for (let attempt = 1; attempt <= maxRetries; attempt++) {
    try {
      const response = await fetch(url);
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return await response.json();
    } catch (error) {
      if (attempt === maxRetries) {
        throw new Error(`Failed to fetch after ${maxRetries} attempts: ${error.message}`);
      }
      console.log(`Attempt ${attempt} failed, retrying in ${attempt * 1000}ms...`);
      await delay(attempt * 1000);
    }
  }
}

let posts = [];
try {
  posts = await fetchWithRetry(`${WP_API_URL}/posts?per_page=${postCount}&order=desc&orderby=date`);
} catch (error) {
  console.error('Failed to fetch blog posts:', error);
}

const blogUrl = new URL('/blog', Astro.url.origin).pathname;
---

<section class="section-post-feed py-10 md:py-20">
  <div class="container">
    <h2 class="text-2xl md:text-3xl font-heading text-brand-primary mb-10">Latest Posts</h2>
    
    {posts.length > 0 ? (
      <div class="grid gap-5 md:gap-10">
        {posts.map((post) => (
          <PostItem post={post} blogUrl={blogUrl} />
        ))}
      </div>
    ) : (
      <div class="bg-surface-card rounded-lg p-5">
        <p class="text-center text-base-gray">Unable to load blog posts at this time. Please try again later.</p>
      </div>
    )}
    
    <div class="text-center mt-10">
      <a 
        href={blogUrl} 
        class="inline-block px-8 py-3 bg-brand-primary text-base-white rounded-lg hover:bg-brand-accent hover:text-brand-primary transition-colors"
      >
        View All Posts
      </a>
    </div>
  </div>
</section>

<style>
  .section-post-feed {
    background-color: theme(colors.base.lighter);
  }
</style>