---
import flower from "../assets/flower-lime.svg";

interface Props {
  svgSrc?: string;
}

const { svgSrc = flower.src } = Astro.props;
---

<section class="flex flex-col items-center w-full">
  <div class="w-full lg:w-2/3 py-10 lg:py-20 mx-auto flex justify-end">
    <img
      src={svgSrc}
      alt="Decorative flower"
      class="block ml-auto mr-10 lg:mr-0 w-12 h-12 md:w-16 md:h-16"
    />
  </div>
</section>
