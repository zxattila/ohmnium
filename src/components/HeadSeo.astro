---
import type { AccordionItem } from "../components/Faq.astro";
import {
  calculateAggregateRating,
  type GooglePlacesReview,
} from "../data/reviews";

export interface Props {
  schemaType?:
    | "WebPage"
    | "ContactPage"
    | "AboutPage"
    | "Organization"
    | "Blog"
    | "BlogPosting"
    | "FAQPage"
    | "LocalBusiness";
  title: string;
  description: string;
  url?: string;
  datePublished?: string;
  dateModified?: string;
  author?: string;
  faqItems?: AccordionItem[];
  reviews?: GooglePlacesReview[];
  businessName?: string;
  businessType?: string;
  address?: {
    streetAddress?: string;
    addressLocality?: string;
    addressRegion?: string;
    postalCode?: string;
    addressCountry?: string;
  };
  phoneNumber?: string;
  email?: string;
}

const {
  schemaType = "WebPage",
  title,
  description,
  url,
  datePublished,
  dateModified,
  author,
  faqItems,
  reviews,
  businessName,
  businessType = "Electrician",
  address,
  phoneNumber,
  email,
} = Astro.props;

const canonicalURL = url || Astro.url.href;
const siteUrl = Astro.site?.href || "https://ohmnium.co.uk";
const siteName = businessName || "Ohmnium Electricians";

// Base organization data
const organizationData = {
  "@type": "Organization",
  name: siteName,
  url: siteUrl,
  logo: {
    "@type": "ImageObject",
    url: `${siteUrl}/logo.png`,
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    areaServed: "London, UK",
    ...(phoneNumber && { telephone: phoneNumber }),
    ...(email && { email: email }),
  },
  address: address
    ? {
        "@type": "PostalAddress",
        ...(address.streetAddress && { streetAddress: address.streetAddress }),
        ...(address.addressLocality && {
          addressLocality: address.addressLocality,
        }),
        ...(address.addressRegion && { addressRegion: address.addressRegion }),
        ...(address.postalCode && { postalCode: address.postalCode }),
        ...(address.addressCountry && {
          addressCountry: address.addressCountry,
        }),
      }
    : {
        "@type": "PostalAddress",
        addressLocality: "London",
        addressCountry: "GB",
      },
  serviceArea: {
    "@type": "Place",
    name: "London",
  },
};

// Schema data based on page type
let schemaData;

if (schemaType === "Organization") {
  schemaData = {
    "@context": "https://schema.org",
    ...organizationData,
  };
} else if (schemaType === "LocalBusiness") {
  const aggregateRating = calculateAggregateRating(reviews || []);

  schemaData = {
    "@context": "https://schema.org",
    "@type":
      businessType === "Electrician" ? "ProfessionalService" : "LocalBusiness",
    name: siteName,
    description: description,
    url: siteUrl,
    ...(phoneNumber && { telephone: phoneNumber }),
    ...(email && { email: email }),
    address: address
      ? {
          "@type": "PostalAddress",
          ...(address.streetAddress && {
            streetAddress: address.streetAddress,
          }),
          ...(address.addressLocality && {
            addressLocality: address.addressLocality,
          }),
          ...(address.addressRegion && {
            addressRegion: address.addressRegion,
          }),
          ...(address.postalCode && { postalCode: address.postalCode }),
          ...(address.addressCountry && {
            addressCountry: address.addressCountry,
          }),
        }
      : {
          "@type": "PostalAddress",
          addressLocality: "London",
          addressCountry: "GB",
        },
    geo: {
      "@type": "GeoCoordinates",
      latitude: 51.5074, // London coordinates
      longitude: -0.1278,
    },
    areaServed: {
      "@type": "Place",
      name: "London, UK",
    },
    ...(aggregateRating && {
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: aggregateRating.ratingValue,
        reviewCount: aggregateRating.reviewCount,
        bestRating: aggregateRating.bestRating,
        worstRating: aggregateRating.worstRating,
      },
    }),
    ...(reviews &&
      reviews.length > 0 && {
        review: reviews.map((reviewData) => ({
          "@type": "Review",
          author: {
            "@type": "Person",
            name: reviewData.author_name,
          },
          reviewRating: {
            "@type": "Rating",
            ratingValue: reviewData.rating,
            bestRating: 5,
            worstRating: 1,
          },
          reviewBody: reviewData.text,
          datePublished: new Date(reviewData.time * 1000).toISOString(),
        })),
      }),
    priceRange: "$$",
    serviceType: "Electrical Services",
  };
} else if (schemaType === "Blog") {
  schemaData = {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: title,
    description: description,
    url: canonicalURL,
    publisher: organizationData,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalURL,
    },
    isPartOf: {
      "@type": "WebSite",
      name: siteName,
      url: siteUrl,
    },
  };
} else if (schemaType === "BlogPosting") {
  schemaData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: description,
    url: canonicalURL,
    ...(datePublished && { datePublished: datePublished }),
    ...(dateModified && { dateModified: dateModified }),
    ...(author && {
      author: {
        "@type": "Person",
        name: author,
      },
    }),
    publisher: organizationData,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalURL,
    },
    isPartOf: {
      "@type": "WebSite",
      name: siteName,
      url: siteUrl,
    },
  };
} else if (schemaType === "FAQPage") {
  if (!faqItems || faqItems.length === 0) {
    throw new Error("FAQPage schema requires faqItems to be provided");
  }
  schemaData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    name: title,
    description: description,
    url: canonicalURL,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.title,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.content,
      },
    })),
    publisher: organizationData,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalURL,
    },
    isPartOf: {
      "@type": "WebSite",
      name: siteName,
      url: siteUrl,
    },
  };
} else {
  schemaData = {
    "@context": "https://schema.org",
    "@type": schemaType,
    name: title,
    description: description,
    url: canonicalURL,
    publisher: organizationData,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalURL,
    },
    isPartOf: {
      "@type": "WebSite",
      name: siteName,
      url: siteUrl,
    },
  };
}
---

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
