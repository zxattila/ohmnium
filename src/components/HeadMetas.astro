---
// Props interface
export interface Props {
  title: string;
  description: string;
  url?: string;
  siteName?: string;
  type?: "website" | "article" | "product" | "product.group";
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  twitterHandle?: string;
  keywords?: string;
  author?: string;
  robots?: string;
  language?: string;
  businessName?: string;
  businessPhone?: string;
  businessAddress?: string;
}

const {
  title,
  description,
  url,
  siteName = "Ohmnium Electricians",
  type = "website",
  image,
  imageWidth,
  imageHeight,
  twitterHandle,
  keywords,
  author,
  robots = "index, follow",
  language = "en-GB",
  businessName,
  businessPhone,
  businessAddress,
} = Astro.props;

const canonicalURL = url || Astro.url.href;
---

<!-- Basic Meta Tags -->
<meta name="description" content={description} />
<title>{title}</title>
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={robots} />
<meta name="language" content={language} />
{keywords && <meta name="keywords" content={keywords} />}
{author && <meta name="author" content={author} />}

<!-- Business-specific meta tags for local SEO -->
{
  businessName && (
    <meta name="business:contact_data:locality" content={businessName} />
  )
}
{
  businessPhone && (
    <meta name="business:contact_data:phone_number" content={businessPhone} />
  )
}
{
  businessAddress && (
    <meta
      name="business:contact_data:street_address"
      content={businessAddress}
    />
  )
}

<!-- Geo meta tags for local business -->
<meta name="geo.region" content="GB-LND" />
<meta name="geo.placename" content="London" />
<meta name="ICBM" content="51.5074, -0.1278" />

<!-- Open Graph Meta Tags -->
<meta property="og:site_name" content={siteName} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:type" content={type} />
<meta property="og:description" content={description} />

{
  image && (
    <>
      <meta property="og:image" content={image} />
      {imageWidth && (
        <meta property="og:image:width" content={imageWidth.toString()} />
      )}
      {imageHeight && (
        <meta property="og:image:height" content={imageHeight.toString()} />
      )}
    </>
  )
}

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{twitterHandle && <meta name="twitter:site" content={`@${twitterHandle}`} />}
{image && <meta name="twitter:image" content={image} />}
