---
// Props interface
export interface Props {
  title: string;
  description: string;
  url?: string;
  siteName?: string;
  type?: "website" | "article" | "product" | "product.group";
  image?: string | ImageMetadata;
  imageWidth?: number;
  imageHeight?: number;
  twitterHandle?: string;
  keywords?: string;
  author?: string;
  robots?: string;
  language?: string;
  businessName?: string;
  businessPhone?: string;
  businessAddress?: string;
}

import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import fallbackImg from "../assets/fallback.jpg";

const {
  title,
  description,
  url,
  siteName = "Ohmnium Electricians",
  type = "website",
  image,
  imageWidth,
  imageHeight,
  twitterHandle,
  keywords,
  author,
  robots = "index, follow",
  language = "en-GB",
  businessName,
  businessPhone,
  businessAddress,
} = Astro.props;

const siteUrl = Astro.site?.href || "https://ohmnium.co.uk";
const canonicalURL = url || `${siteUrl}${Astro.url.pathname}`;

// Optimize images for social media sharing
let defaultImage = image;
let optimizedWidth = imageWidth || 1200;
let optimizedHeight = imageHeight || 630;

if (!image) {
  try {
    // Create an optimized JPEG version of the fallback image for social media
    const optimizedFallback = await getImage({
      src: fallbackImg,
      width: 1200,
      height: 630,
      format: "jpeg",
      quality: 85, // Optimized for social media - good quality, smaller file size
    });

    defaultImage = `${siteUrl}${optimizedFallback.src}`;
    optimizedWidth = 1200;
    optimizedHeight = 630;
  } catch (error) {
    console.error("Failed to optimize fallback image:", error);
    // Fall back to original fallback image
    defaultImage = `${siteUrl}/fallback.jpg`;
  }
} else if (typeof image === "object") {
  try {
    // If image is an imported asset (ImageMetadata), optimize it
    const optimizedCustom = await getImage({
      src: image,
      width: imageWidth || 1200,
      height: imageHeight || 630,
      format: "jpeg",
      quality: 85, // Optimized for social media
    });

    defaultImage = `${siteUrl}${optimizedCustom.src}`;
    optimizedWidth = imageWidth || 1200;
    optimizedHeight = imageHeight || 630;
  } catch (error) {
    console.error("Failed to optimize custom image:", error);
    // Fall back to the original image if optimization fails
    defaultImage = `${siteUrl}${image.src}`;
  }
} else {
  // If image is a string URL, use it as-is (could be external URL)
  defaultImage = image.startsWith("http") ? image : `${siteUrl}${image}`;
}
---

<!-- Basic Meta Tags -->
<meta name="description" content={description} />
<title>{title}</title>
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={robots} />
<meta name="language" content={language} />
{keywords && <meta name="keywords" content={keywords} />}
{author && <meta name="author" content={author} />}

<!-- Business-specific meta tags for local SEO -->
{
  businessName && (
    <meta name="business:contact_data:locality" content={businessName} />
  )
}
{
  businessPhone && (
    <meta name="business:contact_data:phone_number" content={businessPhone} />
  )
}
{
  businessAddress && (
    <meta
      name="business:contact_data:street_address"
      content={businessAddress}
    />
  )
}

<!-- Geo meta tags for local business -->
<meta name="geo.region" content="GB-LND" />
<meta name="geo.placename" content="London" />
<meta name="ICBM" content="51.5074, -0.1278" />

<!-- Open Graph Meta Tags -->
<meta property="og:site_name" content={siteName} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:type" content={type} />
<meta property="og:description" content={description} />
<meta property="og:image" content={defaultImage} />
<meta property="og:image:secure_url" content={defaultImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content={optimizedWidth.toString()} />
<meta property="og:image:height" content={optimizedHeight.toString()} />

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{twitterHandle && <meta name="twitter:site" content={`@${twitterHandle}`} />}
<meta name="twitter:image" content={defaultImage} />
