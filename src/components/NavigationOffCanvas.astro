---
// Get the current path from Astro.url
const currentPath = Astro.url.pathname;

// Nav items array with dynamically determined active state
const navItems = [
  { href: "/", text: "Home", active: currentPath === "/" },
  { href: "/about", text: "About", active: currentPath.startsWith("/about") },
  { href: "/blog", text: "Blog", active: currentPath.startsWith("/blog") },
  {
    href: "/contact",
    text: "Contact",
    active: currentPath.startsWith("/contact"),
  },
];
---

<header
  class="bg-gray-50 shadow-lg fixed w-full top-0 z-50 transition-transform duration-300"
  x-data="{ 
    lastScroll: 0,
    showNav: true,
    init() {
      window.addEventListener('scroll', () => {
        const currentScroll = window.pageYOffset;
        if (currentScroll <= 0) {
          this.showNav = true;
          return;
        }
        
        if (currentScroll > this.lastScroll && this.showNav) {
          // Scrolling down
          this.showNav = false;
        } else if (currentScroll < this.lastScroll && !this.showNav) {
          // Scrolling up
          this.showNav = true;
        }
        
        this.lastScroll = currentScroll;
      });
    }
  }"
  :class="{ 'translate-y-0': showNav, '-translate-y-full': !showNav }"
>
  <nav class="container py-2.5">
    <div class="flex items-center justify-between">
      <div class="flex-shrink-0">
        <a href="/">
          <img
            src="/src/assets/logo.svg"
            alt="Logo"
            class="max-w-[200px] w-full h-auto"
          />
        </a>
      </div>

      <!-- Mobile menu button -->
      <button @click="$store.navigation.toggle()" class="md:hidden">
        <span class="sr-only">Toggle menu</span>
        <svg
          class="h-10 w-10 text-black"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            x-show="!$store.navigation.isMenuOpen"
            stroke-linecap="butt"
            stroke-linejoin="miter"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
          <path
            x-show="$store.navigation.isMenuOpen"
            stroke-linecap="butt"
            stroke-linejoin="miter"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex space-x-6">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`nav-link ${item.active ? "active" : ""}`}
            >
              {item.text}
            </a>
          ))
        }
      </div>
      <!-- CTA Button -->
      <button class="button button-primary hidden md:block"
        >020 3500 1441</button
      >
    </div>

    <!-- Mobile Navigation -->
    <div
      x-show="$store.navigation.isMenuOpen"
      class="md:hidden mt-4 relative z-50"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={`nav-link block py-2 ${item.active ? "active" : ""}`}
          >
            {item.text}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<!-- Spacer to prevent content from hiding under fixed nav -->
<div class="h-14 md:h-16"></div>
