---
import { Image } from "astro:assets";

// Props interface
interface Props {
  src: ImageMetadata | string;
  alt: string;
  usePicture?: boolean;
  lazy?: boolean;
  widths?: number[];
  sizes?: string;
  formats?: string[];
  quality?: number;
  class?: string;
  width?: number;
  height?: number;
}

// Default props
const {
  src,
  alt,
  usePicture = true,
  lazy = true,
  widths = [412, 640, 768, 1024, 1280, 1536], // Mobile-first with PageSpeed optimal 412px
  sizes = "(max-width: 412px) 412px, (max-width: 640px) 640px, (max-width: 768px) 768px, (max-width: 1024px) 1024px, (max-width: 1280px) 1280px, 1536px",
  formats = ["avif", "webp"],
  quality = 80,
  class: className = "",
  width,
  height,
  ...rest
} = Astro.props;

// Auto-detect dimensions if not provided and src is ImageMetadata
let imageWidth = width;
let imageHeight = height;

if (!width && !height && typeof src === "object" && "width" in src) {
  imageWidth = src.width;
  imageHeight = src.height;
}
---

{
  usePicture ? (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={formats}
      quality={quality}
      loading={lazy ? "lazy" : "eager"}
      decoding="async"
      width={imageWidth}
      height={imageHeight}
      class={className}
      {...rest}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      width={imageWidth || widths[Math.floor(widths.length / 2)]}
      Use
      middle
      width
      as
      fallback
      height={imageHeight}
      quality={quality}
      loading={lazy ? "lazy" : "eager"}
      decoding="async"
      class={className}
      {...rest}
    />
  )
}
