---
import Accordion from "../components/Accordion.astro";
import flower from "../assets/flower-green.svg";

interface AccordionItem {
  title: string;
  content: string;
}

interface Props {
  title?: string;
  svgSrc?: string;
  accordionItems?: AccordionItem[];
}

// Dummy data for electrician FAQs
const defaultAccordionItems: AccordionItem[] = [
  {
    title: "What electrical services do you offer?",
    content:
      "We offer comprehensive electrical services for homes and businesses in London & the Home Counties. This includes fault finding, EICRs, rewires, fuse board upgrades, EV charger installations, plus fire alarm and emergency lighting systems. We expertly handle urgent repairs, planned upgrades, and all your essential compliance work.",
  },
  {
    title: "Do you provide estimates for electrical work?",
    content:
      "Getting an estimate from us is straightforward and free! We'll discuss your electrical needs, then assess the work required—sometimes remotely, or with a site visit if necessary. You'll receive a clear, itemised quote with transparent pricing. No hidden costs, so you'll always know the exact scope and cost upfront.",
  },
  {
    title: "Do you provide EICRs and safety certificates?",
    content:
      "Absolutely! We provide Electrical Installation Condition Reports (EICRs) for landlords, homeowners, and businesses. These are vital for legal compliance and ensuring your electrical systems are safe. Our team inspects, tests, and certifies your installation, offering clear advice on any remedial work that might be needed for full peace of mind.",
  },
  {
    title: "How quickly can you respond?",
    content:
      "We prioritise a swift response for all urgent electrical issues. During business hours (Mon-Fri 8am-8pm, Sat 8am-5pm), we often attend to emergencies same-day. For non-urgent tasks, we'll schedule a time that suits you. For out-of-hours emergencies, please call us; we'll guide you or refer you if we cannot assist directly.",
  },
  {
    title: "Do you handle small and large projects?",
    content:
      "Yes, definitely! From fixing a single socket to a complete property rewire, our skilled team handles projects of all scales. No job is too small or too complex. We also work closely with estate agents, offering prompt electrical services for managed properties, assisting with new tenancies, and supporting sales or letting requirements.",
  },
];

const {
  title = "Frequently<br>asked<br>questions",
  svgSrc = flower.src,
  accordionItems = defaultAccordionItems,
} = Astro.props;
---

<section
  class="grid gap-5 lg:grid-cols-4 grid-cols-1 lg:grid-rows-1 grid-rows-auto py-10 md:py-20"
>
  <!-- Title Column: spans 1 on lg, combined with image on default -->
  <div class="lg:col-span-1 col-span-1 row-start-1">
    <div class="flex flex-row items-start lg:block">
      <h2
        class="text-4xl md:text-5xl md:leading-extra-tight font-bold"
        set:html={title}
      />
      <img
        src={svgSrc}
        alt="Decorative flower"
        class="ml-4 mt-2 lg:ml-0 lg:mt-4 lg:mr-auto w-12 h-12 md:w-16 md:h-16 block"
      />
    </div>
  </div>

  <!-- Accordion Component Column: spans 2 on lg, 2 on default (second row) -->
  <div class="lg:col-span-2 col-span-full row-start-2 lg:row-start-1">
    <Accordion accordionItems={accordionItems} />
  </div>

  <!-- SVG Column: spans 1 on lg, hidden on default -->
  <div class="lg:col-span-1 col-span-1 row-start-1 hidden lg:block"></div>
</section>
