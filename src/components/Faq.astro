---
import Accordion from "../components/Accordion.astro";
import flower from "../assets/flower-green.svg";

export interface AccordionItem {
  title: string;
  content: string;
}

interface Props {
  title?: string;
  svgSrc?: string;
  accordionItems?: AccordionItem[];
}

// Default FAQ data for electrician services - exported for reuse in schema
export const defaultElectricalFaqItems: AccordionItem[] = [
  {
    title: "What types of electrical services do you offer?",
    content:
      "We provide comprehensive electrical services across London, Enfield, and the Home Counties. Our team specialises in EICRs, rewiring, consumer unit upgrades, EV charger installs, fault finding, and fire alarm or emergency lighting systems.",
  },
  {
    title: "Do you offer free quotes or site assessments?",
    content:
      "Yes! We provide free estimates for all electrical work. After discussing your needs, we'll either assess remotely or schedule a site visit. Expect a clear, itemised quote with no hidden costs.",
  },
  {
    title: "Can you install or inspect fire alarms and smoke detectors?",
    content:
      "Absolutely. We install and test hardwired and interlinked fire alarm systems, including heat and carbon monoxide detectors. All systems meet the latest safety regulations and are suitable for HMOs and domestic properties.",
  },
  {
    title: "Do you provide EICRs and landlord safety certificates?",
    content:
      "Yes, we carry out Electrical Installation Condition Reports (EICRs) for landlords, homeowners, and businesses. These reports are essential for legal compliance, property sales, and tenancy agreements. We test and document your installation, advising on any remedial work needed to meet safety standards.",
  },
  {
    title: "Do you offer full home rewiring services?",
    content:
      "We provide complete or partial rewiring services for residential and commercial properties. Whether you're upgrading an old system, renovating, or modernising, we ensure your installation is safe, up to current regulations, and fit for future electrical demands.",
  },
  {
    title: "How fast can you respond to urgent electrical issues?",
    content:
      "We can offer same-day service for emergencies during business hours (Mon–Fri 8am–8pm, Sat 8am–5pm) depending on our schedule. For non-urgent work, we’ll book a time that suits you. If you call us out of hours, we’ll either advise you directly or refer you to someone who can help.",
  },
  {
    title: "Do you work on small jobs and large projects alike?",
    content:
      "Yes, we take on everything from small tasks like socket replacements to full rewires or commercial installations. We also support estate agents and landlords with ongoing electrical maintenance and compliance services.",
  },
];

const {
  title = "Frequently<br>asked<br>questions",
  svgSrc = flower.src,
  accordionItems = defaultElectricalFaqItems,
} = Astro.props;
---

<section
  class="grid gap-5 lg:grid-cols-4 grid-cols-1 lg:grid-rows-1 grid-rows-auto py-10 md:py-20"
>
  <!-- Title Column: spans 1 on lg, combined with image on default -->
  <div class="lg:col-span-1 col-span-1 row-start-1">
    <div class="flex flex-row items-start lg:block">
      <h2
        class="text-4xl md:text-5xl md:leading-extra-tight"
        set:html={title}
      />
      <img
        src={svgSrc}
        alt="Decorative flower"
        class="ml-4 mt-2 lg:ml-0 lg:mt-4 lg:mr-auto w-12 h-12 md:w-16 md:h-16 block"
      />
    </div>
  </div>

  <!-- Accordion Component Column: spans 2 on lg, 2 on default (second row) -->
  <div class="lg:col-span-2 col-span-full row-start-2 lg:row-start-1">
    <Accordion accordionItems={accordionItems} />
  </div>

  <!-- SVG Column: spans 1 on lg, hidden on default -->
  <div class="lg:col-span-1 col-span-1 row-start-1 hidden lg:block"></div>
</section>
