---
const navItems = [
  { href: "/", text: "Home", active: true },
  { href: "/blog", text: "Blog", active: false },
  { href: "/about", text: "About", active: false },
  { href: "/contact", text: "Contact", active: false },
];
---

<header
  class="bg-white shadow fixed w-full top-0 z-50 transition-transform duration-300"
  x-data="{ 
    isOpen: false,
    lastScroll: 0,
    showNav: true,
    init() {
      window.addEventListener('scroll', () => {
        const currentScroll = window.pageYOffset;
        if (currentScroll <= 0) {
          this.showNav = true;
          return;
        }
        
        if (currentScroll > this.lastScroll && this.showNav) {
          // Scrolling down
          this.showNav = false;
        } else if (currentScroll < this.lastScroll && !this.showNav) {
          // Scrolling up
          this.showNav = true;
        }
        
        this.lastScroll = currentScroll;
      });
    }
  }"
  :class="{ 'translate-y-0': showNav, '-translate-y-full': !showNav }"
>
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <div class="flex-shrink-0">
        <a href="/">
          <img
            src="/src/assets/logo.svg"
            alt="Logo"
            class="max-w-[200px] w-full h-auto"
          />
        </a>
      </div>

      <!-- Mobile menu button -->
      <button @click="isOpen = !isOpen" class="md:hidden">
        <span class="sr-only">Toggle menu</span>
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            x-show="!isOpen"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
          <path
            x-show="isOpen"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex space-x-6">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`hover:text-blue-600 ${item.active ? "text-blue-600 font-medium" : ""}`}
            >
              {item.text}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div
      x-show="isOpen"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="md:hidden mt-4"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={`block py-2 hover:text-blue-600 ${item.active ? "text-blue-600 font-medium" : ""}`}
          >
            {item.text}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<!-- Spacer to prevent content from hiding under fixed nav -->
<div class="h-16"></div>
