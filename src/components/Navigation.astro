---
const navItems = [
  { href: "/", text: "Home", active: true },
  { href: "/blog", text: "Blog", active: false },
  { href: "/about", text: "About", active: false },
  { href: "/contact", text: "Contact", active: false },
];

const currentPath = Astro.url.pathname;
---

<a href="#main-content" class="sr-only focus:not-sr-only">
  Skip to main content
</a>

<header
  class="bg-brand-primary fixed w-full top-0 z-50 transition-transform duration-300"
  x-data="{ 
    isOpen: false,
    lastScroll: 0,
    showNav: true,
    init() {
      window.addEventListener('scroll', () => {
        const currentScroll = window.pageYOffset;
        if (currentScroll <= 0) {
          this.showNav = true;
          return;
        }
        
        if (currentScroll > this.lastScroll && this.showNav) {
          this.showNav = false;
        } else if (currentScroll < this.lastScroll && !this.showNav) {
          this.showNav = true;
        }
        
        this.lastScroll = currentScroll;
      });
    }
  }"
  :class="{ 'translate-y-0': showNav, '-translate-y-full': !showNav }"
>
  <nav class="container h-16 md:h-20">
    <div class="flex items-center justify-between h-full">
      <div class="flex-shrink-0">
        <a href="/" class="block">
          <img
            src="/src/assets/logo.svg"
            alt="Logo"
            class="h-8 md:h-10 w-auto"
            style="filter: brightness(0) invert(1);"
          />
        </a>
      </div>

      <button 
        @click="isOpen = !isOpen" 
        class="lg:hidden p-2 text-base-white"
        aria-label="Toggle menu"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            x-show="!isOpen"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
          <path
            x-show="isOpen"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>

      <div class="hidden lg:flex items-center space-x-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-lg font-heading text-base-white hover:text-brand-accent transition-colors",
              { "text-brand-accent": currentPath === item.href }
            ]}
          >
            {item.text}
          </a>
        ))}
      </div>
    </div>

    <div
      x-show="isOpen"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 -translate-x-full"
      x-transition:enter-end="opacity-100 translate-x-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-x-0"
      x-transition:leave-end="opacity-0 -translate-x-full"
      class="fixed inset-0 z-50 lg:hidden"
      @click.away="isOpen = false"
    >
      <div class="absolute inset-0 bg-overlay-70" @click="isOpen = false"></div>
      <nav class="absolute top-0 left-0 bottom-0 w-5/6 max-w-sm bg-brand-primary">
        <div class="h-16 md:h-20 flex items-center px-5">
          <button 
            @click="isOpen = false"
            class="ml-auto p-2 text-base-white"
            aria-label="Close menu"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
        <div class="px-5 py-3">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "block py-3 text-lg font-heading text-base-white hover:text-brand-accent transition-colors",
                { "text-brand-accent": currentPath === item.href }
              ]}
            >
              {item.text}
            </a>
          ))}
        </div>
      </nav>
    </div>
  </nav>
</header>

<!-- Spacer to prevent content from hiding under fixed nav -->
<div class="h-16 md:h-20"></div>