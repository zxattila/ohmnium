---
import Card from "./Card.astro";
import electricianImage01 from "../assets/inspection.png";
import electricianImage02 from "../assets/faultfinding.jpg";
import electricianImage03 from "../assets/rewiring.jpg";
import electricianImage04 from "../assets/consumerunit.jpg";

const cards = [
  {
    imgSrc: electricianImage01.src,
    title: "Inspection & Testing",
    description:
      "Ensure safety and compliance with thorough inspections and certifications for residential and commercial properties.",
  },
  {
    imgSrc: electricianImage02.src,
    title: "Fault Finding & Repairs",
    description:
      "Quickly diagnose and resolve electrical issues, minimising downtime and inconvenience.",
  },
  {
    imgSrc: electricianImage03.src,
    title: "Full Home Rewiring",
    description:
      "Complete property rewiring services, enhancing safety and meeting modern electrical standards.",
  },
  {
    imgSrc: electricianImage04.src,
    title: "Consumer Unit Upgrades",
    description:
      "Upgrade to modern, safe, and efficient consumer units to meet today’s electrical demands.",
  },
];
---

<section class="grid gap-5 lg:grid-cols-4 sm:grid-cols-2 py-5">
  {cards.map((card) => <Card {...card} />)}
</section>
