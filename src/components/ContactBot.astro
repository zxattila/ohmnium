<div x-data="contactBot" class="md:max-w-2xl mx-auto">
  <div class="form-control mb-6">
    <label for="name" class="label">
      <span class="label-text text-gray-700 font-medium"
        >Save time by using our form bot</span
      >
    </label>
    <textarea
      id="prompt"
      x-model="prompt"
      class="textarea textarea-ghost textarea-bordered w-full h-32 lg:h-48 focus:textarea-primary resize-none py-7"
      @input="response = ''"
      @keydown.enter="submitPrompt"
      @focus="handleIOSFocus"
      @blur="handleIOSBlur"
      rows="4"
      style="font-size: 16px;"
      placeholder="How can we help you today?"></textarea>
  </div>

  <div class="flex justify-end">
    <button
      @click="submitPrompt"
      :disabled="loading"
      class="button button-primary w-full disabled:opacity-50 disabled:cursor-not-allowed"
      x-text="loading ? 'Processing...' : 'Submit'"></button>
  </div>

  <div
    x-show="response"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 transform -translate-y-4"
    x-transition:enter-end="opacity-100 transform translate-y-0"
    class="mt-6 p-4 bg-gray-100 rounded-lg"
  >
    <h3 class="font-semibold mb-2">Response:</h3>
    <p x-text="response" class="text-gray-700"></p>
  </div>
</div>

<script>
  document.addEventListener("alpine:init", () => {
    Alpine.data("contactBot", () => ({
      prompt: "",
      response: "",
      loading: false,

      async submitPrompt() {
        if (!this.prompt.trim()) return;

        this.loading = true;
        try {
          const response = await fetch("/api/chat", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ prompt: this.prompt }),
          });

          if (!response.ok) {
            throw new Error("Network response was not ok");
          }

          const data = await response.json();
          this.response = data.response;

          // Show contact form if needed
          // if (data.metadata?.requiresContact) {
          //   this.showContactForm = true;
          // }
        } catch (error) {
          console.error("Error:", error);
          this.response = "Sorry, there was an error processing your request.";
        } finally {
          this.loading = false;
        }
      },

      // iOS Safari viewport fix methods
      handleIOSFocus(event) {
        if (this.isIOS()) {
          // Temporarily disable fixed positioning during focus
          const header = document.querySelector("header");
          if (header) {
            header.classList.add("ios-keyboard-fix");
          }

          // Scroll element into view with padding
          setTimeout(() => {
            event.target.scrollIntoView({
              behavior: "smooth",
              block: "center",
              inline: "nearest",
            });
          }, 300);
        }
      },

      handleIOSBlur() {
        if (this.isIOS()) {
          // Re-enable fixed positioning after blur
          const header = document.querySelector("header");
          if (header) {
            header.classList.remove("ios-keyboard-fix");
          }

          // Reset viewport
          setTimeout(() => {
            window.scrollTo(window.scrollX, window.scrollY);
          }, 100);
        }
      },

      isIOS() {
        return /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
      },
    }));
  });
</script>
