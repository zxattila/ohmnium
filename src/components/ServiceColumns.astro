---
import Card from "./Card.astro";

// Props
interface Props {
  showEmojis?: boolean;
}

const { showEmojis = false } = Astro.props;

// SVG content for all service cards
const cardSvgContent = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
  <path fill-rule="evenodd" d="M12.516 2.17a.75.75 0 0 0-1.032 0 11.209 11.209 0 0 1-7.877 3.08.75.75 0 0 0-.722.515A12.74 12.74 0 0 0 2.25 9.75c0 5.942 4.064 10.933 9.563 12.348a.749.749 0 0 0 .374 0c5.499-1.415 9.563-6.406 9.563-12.348 0-1.39-.223-2.73-.635-3.985a.75.75 0 0 0-.722-.516l-.143.001c-2.996 0-5.717-1.17-7.734-3.08Zm3.094 8.016a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" />
</svg>`;

// Service data with emojis
const serviceData = [
  {
    emoji: "📋",
    title: "NICEIC Electrical Installation Condition Reports (EICR)",
    description:
      "Periodic inspection and testing for landlords, homeowners, and businesses.",
  },
  {
    emoji: "🏠",
    title: "Landlord Electrical Safety Certificates",
    description: "Ensure your property meets legal safety standards.",
  },
  {
    emoji: "🔌",
    title: "Portable Appliance Testing (PAT Testing)",
    description: "For residential lets, commercial properties, and offices.",
  },
  {
    emoji: "🚨",
    title: "Emergency Lighting Testing & Installation",
    description:
      "Up to 10-point emergency lighting systems tested or installed.",
  },
  {
    emoji: "🔥",
    title: "Fire Alarm Testing & Installation",
    description: "Suitable for HMOs, rentals, and commercial premises.",
  },
  {
    emoji: "💨",
    title: "Smoke, Heat & Carbon Monoxide Alarms",
    description:
      "Hardwired or interlinked detection systems for full compliance.",
  },
  {
    emoji: "🌪️",
    title: "Extractor Fans & Humidity Sensors",
    description: "Bathroom and kitchen ventilation systems.",
  },
  {
    emoji: "💡",
    title: "Lighting Installation & Upgrades",
    description:
      "Indoor and outdoor lighting solutions, including LED upgrades.",
  },
  {
    emoji: "🔌",
    title: "Socket & Switch Installation",
    description: "Additional points, replacements, and decorative finishes.",
  },
  {
    emoji: "🌳",
    title: "Outdoor Power & Garden Lighting",
    description: "Safe and weatherproof installations for outdoor use.",
  },
  {
    emoji: "⚡",
    title: "Consumer Unit (Fusebox) Upgrades",
    description: "Modern RCD, RCBO, and SPD protection for improved safety.",
  },
  {
    emoji: "🍳",
    title: "Cooker & Hob Wiring",
    description: "Installation of dedicated supplies and isolation.",
  },
  {
    emoji: "🚿",
    title: "Electric Shower Installations",
    description: "Including supply upgrades and safety protection.",
  },
  {
    emoji: "🏡",
    title: "Smart Home Automation",
    description:
      "Lighting control, smart sockets, voice integration, and more.",
  },
  {
    emoji: "🔔",
    title: "Ring Doorbell & Smart Security Systems",
    description: "Installation and setup of video doorbells and smart cameras.",
  },
  {
    emoji: "🔧",
    title: "Rewiring Services",
    description:
      "Full or partial rewires for domestic and commercial properties.",
  },
];

// Map service data to Card component format
const services = serviceData.map((service) => ({
  imgSrc: "",
  title: showEmojis ? `${service.emoji} ${service.title}` : service.title,
  description: service.description,
  showImage: false,
  titleClass: "text-sm uppercase mb-0",
  textClass: "text-base leading-snug",
  cardClass: "min-h-28 bg-surface-card",
  showSvg: true,
  svgContent: cardSvgContent,
  svgClasses: "absolute bottom-2 right-2 z-10 text-black",
}));
---

<div class="grid gap-5 lg:grid-cols-2 sm:grid-cols-2 py-5">
  {services.map((service) => <Card {...service} />)}
</div>
