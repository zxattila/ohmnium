---
import Image from "./Image.astro";
import noisier from "../assets/noisier.png";

interface Props {
  title: string;
  description: string;
  useNoise?: boolean;
  backgroundImage?: ImageMetadata | string;
}

const {
  title,
  description,
  useNoise = false,
  backgroundImage = "https://images.pexels.com/photos/2387793/pexels-photo-2387793.jpeg",
} = Astro.props;
---

<header class="relative py-16 md:py-24 mb-10 lg:mb-12 rounded-xl overflow-hidden">
  <!-- Optimized Background Image -->
  {!useNoise && (
    <div class="absolute inset-0">
      <Image
        src={backgroundImage}
        alt=""
        widths={[240, 320, 480, 640, 800]}
        sizes="(max-width: 320px) 240px, (max-width: 480px) 320px, (max-width: 768px) 480px, (max-width: 1024px) 640px, 800px"
        formats={['webp', 'avif']}
        quality={50}
        class="w-full h-full object-cover"
        lazy={false}
      />
      <div class="absolute inset-0 bg-black opacity-50" />
    </div>
  )}
  
  <!-- Noise Background Alternative -->
  {useNoise && (
    <div class="absolute inset-0">
      <Image
        src={noisier}
        alt=""
        widths={[240, 320, 480, 640, 800]}
        sizes="(max-width: 320px) 240px, (max-width: 480px) 320px, (max-width: 768px) 480px, (max-width: 1024px) 640px, 800px"
        formats={['webp', 'avif']}
        quality={65}
        class="w-full h-full object-none"
        lazy={false}
      />
      <!-- Radial gradient overlay with background blend mode -->
      <div class="absolute inset-0 bg-radial from-brand-secondary/90 from-40% to-brand-secondary/95 bg-blend-overlay" />
    </div>
  )}

  <div class="relative z-10 max-w-4xl mx-auto px-4 text-center text-white">
    <h1 class="text-5xl md:text-6xl mb-2 md:mb-4 text-white">
      {title}
    </h1>
    <p class="text-base md:text-xl text-white">{description}</p>
  </div>
</header>
