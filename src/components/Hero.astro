---
import flower from "../assets/flower-orange.svg";
import noisier from "../assets/noisier.png";
import Image from "./Image.astro";

interface Props {
  title?: string;
  description?: string;
  svgSrc?: string;
}

const {
  title = "London<br>Herts<br>Essex<br>Enfield",
  description = "Your trusted partner for modern electrical solutions.",
  svgSrc = flower.src,
} = Astro.props;
---

<section
  class="hero-section relative bg-brand-secondary rounded-xl overflow-hidden"
>
  <!-- Mobile-First Optimized Background Image -->
  <div class="absolute inset-0 opacity-30">
    <Image
      src={noisier}
      alt=""
      widths={[240, 320, 480, 640, 800]}
      sizes="(max-width: 320px) 240px, (max-width: 480px) 320px, (max-width: 768px) 480px, (max-width: 1024px) 640px, 800px"
      formats={["webp", "avif"]}
      quality={65}
      class="w-full h-full object-cover"
      lazy={false}
    />
  </div>

  <!-- Content -->
  <div
    class="relative z-10 flex flex-col items-center justify-center md:flex-row md:items-end md:justify-between mx-auto py-5 px-2 sm:p-5 md:gap-5"
  >
    <h1
      class="hero-title text-center mb-4 md:mb-0 md:text-left text-5xl md:text-6xl text-white md:max-w-[40%] lg:max-w-[50%]"
      set:html={title}
    />
    <p
      class="text-center md:text-left text-base md:text-lg text-white md:max-w-[60%] lg:max-w-[50%]"
    >
      {description}
    </p>
  </div>

  <!-- Absolute Positioned SVG -->
  <!-- <img
    src={svgSrc}
    alt="Decorative flower"
    class="absolute -right-3 md:right-5 top-[75%] md:top-5 w-12 h-12 md:w-16 md:h-16 transform -translate-y-1/2 md:translate-y-0 transition-all duration-300 ease-in-out"
    style="margin-bottom: -10px;"
  /> -->
</section>
