---
import flower from "../assets/flower-orange.svg";

interface Props {
  title?: string;
  description?: string;
  svgSrc?: string;
}

const {
  title = "Electrical Service<br> and Maintenance",
  description = "Your trusted partner for modern electrical solutions.",
  svgSrc = flower.src,
} = Astro.props;
---

<section class="relative bg-brand-secondary rounded-xl">
  <!-- Background Overlay -->
  <div
    class="absolute inset-0 bg-no-repeat bg-cover bg-center opacity-30"
    style="background-image: url('/src/assets/noisier.png');"
  >
  </div>

  <!-- Content -->
  <div
    class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8 mx-auto p-5 min-h-[300px] md:min-h-[400px]"
  >
    <!-- Column 1: Title -->
    <div class="flex flex-col justify-start md:justify-end h-full">
      <h1
        class="self-start text-4xl md:text-5xl md:leading-extra-tight font-bold text-white"
        set:html={title}
      />
    </div>

    <!-- Column 2: Description -->
    <div class="flex flex-col justify-end md:items-end text-left">
      <p class="text-base md:text-lg text-white">{description}</p>
    </div>
  </div>

  <!-- Absolute Positioned SVG -->
  <img
    src={svgSrc}
    alt="Decorative flower"
    class="absolute -right-3 md:right-5 top-[75%] md:top-5 w-12 h-12 md:w-16 md:h-16 transform -translate-y-1/2 md:translate-y-0 transition-all duration-300 ease-in-out"
    style="margin-bottom: -10px;"
  />
</section>
