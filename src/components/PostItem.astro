---
interface Props {
  post: {
    title: { rendered: string };
    excerpt: { rendered: string };
    date: string;
    slug: string;
  };
  blogUrl: string;
}

const { post, blogUrl } = Astro.props;

function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<article class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
  <div class="text-sm text-gray-500 mb-2">{formatDate(post.date)}</div>
  <a href={`${blogUrl}/${post.slug}`} class="block hover:text-blue-600 transition-colors">
    <h2 class="text-xl font-semibold mb-4">{post.title.rendered}</h2>
  </a>
  <div class="prose mb-4" set:html={post.excerpt.rendered} />
  <a href={`${blogUrl}/${post.slug}`} class="text-blue-600 hover:underline inline-flex items-center">
    Read more
    <span class="ml-1">→</span>
  </a>
</article>