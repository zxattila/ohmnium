---
interface Props {
  post: {
    title: { rendered: string };
    excerpt: { rendered: string };
    date: string;
    slug: string;
  };
  blogUrl: string;
}

const { post, blogUrl } = Astro.props;

function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<article
  class="post-item bg-surface-card flex flex-col h-full p-5 rounded-xl shadow-sm hover:shadow-md transition-shadow"
>
  <div class="text-sm mb-2">{formatDate(post.date)}</div>
  <a href={`${blogUrl}/${post.slug}`} class="block group transition-colors">
    <h3
      class="text-xl mb-4 group-hover:text-brand-tertiary transition-colors"
      set:html={post.title.rendered}
    />
  </a>
  <div class="prose line-clamp-3 mb-4" set:html={post.excerpt.rendered} />
  <a
    href={`${blogUrl}/${post.slug}`}
    class="hover:underline inline-flex items-center mt-auto"
  >
    Read More
    <span class="ml-1">→</span>
  </a>
</article>
