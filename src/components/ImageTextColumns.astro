---
import electricianImage from "../assets/electrician-abstract-01.jpg";

interface ColumnData {
  image: string;
  title: string;
  text: string;
}

interface Props {
  columns?: ColumnData[];
}

const defaultColumns: ColumnData[] = [
  {
    title: "Electricians<br> you can<br> trust",
    text: "When something goes wrong with your electrics, you don't have time to wait around. Whether it's a faulty circuit, a tripping fuse board, or a full rewire, you need someone who can fix it fast, do it right, and not leave you chasing them.",
    image: electricianImage.src,
  },
  {
    title: "",
    text: "",
    image: electricianImage.src,
  },
  {
    title: "Reliable Solutions<br> Every Time",
    text: "From estimating how much a project will cost, to finding the right design for you, we ensure each task is executed efficiently. Our qualified team delivers professional electrical services with transparent pricing.",
    image: electricianImage.src,
  },
  {
    title: "",
    text: "",
    image: electricianImage.src,
  },
];

const { columns = defaultColumns } = Astro.props;
---

<section class="grid gap-5 lg:grid-cols-2 sm:grid-cols-1 py-5">
  <!-- Column 1: Text (Order: 1 on all screens) -->
  <div
    class="flex flex-col justify-center items-start lg:w-3/4 sm:w-full order-1"
  >
    <h2
      class="text-5xl md:text-6xl font-bold text-black"
      set:html={columns[0].title}
    />
    <p class="text-gray-600">{columns[0].text}</p>
  </div>

  <!-- Column 2: Image (Order: 2 on all screens) -->
  <div class="flex justify-center order-2">
    <img
      src={columns[1].image}
      alt="Electrician illustration"
      class="rounded-2xl object-cover h-96 w-full shadow-md"
    />
  </div>

  <!-- Column 3: Text (Order: 3 mobile, 4 lg+) -->
  <div
    class="flex flex-col justify-center items-start lg:w-3/4 sm:w-full order-3 lg:order-4"
  >
    <h2
      class="text-5xl md:text-6xl font-bold text-black"
      set:html={columns[2].title}
    />
    <p class="text-gray-600">{columns[2].text}</p>
  </div>

  <!-- Column 4: Image (Order: 4 mobile, 3 lg+) -->
  <div class="flex justify-center order-4 lg:order-3">
    <img
      src={columns[3].image}
      alt="Electrician illustration"
      class="rounded-2xl object-cover h-96 w-full shadow-md"
    />
  </div>
</section>
