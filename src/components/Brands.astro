---
// Import the SVG assets directly with ?url to get their paths
import brandAico from "../assets/brand-aico.svg?url";
import brandBosch from "../assets/brand-bosch.svg?url";
import brandDeta from "../assets/brand-deta.svg?url";
import brandElkay from "../assets/brand-elkay.svg?url";

// Props interface
interface Props {
  title?: string;
  disclaimer?: string;
}

// Destructuring props with default values
const {
  title = "Brands we trust and use",
  disclaimer = "Please note: We are not affiliated with, sponsored by, or endorsing these brands. We simply use their products as part of our commitment to quality.",
} = Astro.props;

// Brand data array
const brands = [
  { src: brandElkay, alt: "Elkay brand logo" },
  { src: brandAico, alt: "Aico brand logo" },
  { src: brandBosch, alt: "Bosch brand logo" },
  { src: brandDeta, alt: "Deta brand logo" },
];
---

<section class="py-10 md:py-12">
  <!-- Intro text - center aligned -->
  <div class="text-center mb-8">
    <h4 class="text-base lg:text-lg font-semibold text-gray-800">{title}</h4>
  </div>

  <!-- Brands wrapper - center aligned grid/flex layout -->
  <div class="flex justify-center mb-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl">
      {
        brands.map((brand) => (
          <div class="flex items-center justify-center h-[30px] lg:h-[40px]">
            <img
              src={brand.src}
              alt={brand.alt}
              class="max-h-full w-auto object-contain"
            />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Disclaimer - center aligned with max width -->
  <div class="flex justify-center">
    <p class="text-sm text-gray-500 text-center max-w-md">
      {disclaimer}
    </p>
  </div>
</section>
